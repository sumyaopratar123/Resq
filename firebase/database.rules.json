{
  "rules": {
    "responders": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "incidents": {
      "$incidentId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "calls": {
      "$callId": {
        "signaling": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    }
  }
}
